# Backend API base URL
# Dev với Vite proxy: có thể để trống (request /api qua localhost:5173)
# Dev gọi trực tiếp backend hoặc production host chung:
VITE_API_BASE_URL=http://localhost:5068

# CRM Frontend URL (CrmApp inbox)
# Menu "Hội thoại" và các route /messages, /comments, /conversations sẽ chuyển hướng sang URL này.
# Nếu thiếu biến này, menu sẽ bị ẩn và các route trên sẽ hiện thông báo "Chưa cấu hình địa chỉ CRM".
VITE_CRM_URL=http://localhost:5174/inbox
